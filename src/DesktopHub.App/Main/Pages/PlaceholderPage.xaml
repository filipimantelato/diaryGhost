<UserControl x:Class="DesktopHub.App.Main.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,32,40,32" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="GlyphText" Style="{StaticResource IconText}" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock x:Name="TitleBlock" Style="{StaticResource TitleText}" Margin="12,0,0,0" />
      </StackPanel>
      <Border Style="{StaticResource Badge}" Margin="0,14,0,0">
        <TextBlock x:Name="PhaseText" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
      </Border>
      <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyText}" Margin="0,16,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
      <Border Style="{StaticResource Card}" Margin="0,24,0,0">
        <StackPanel>
          <TextBlock Text="Planejado para este módulo" Style="{StaticResource SubtitleText}" />
          <ItemsControl x:Name="PlannedList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="5" Height="5" Fill="{StaticResource TextTertiaryBrush}" VerticalAlignment="Top" Margin="0,7,0,0" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
