<UserControl x:Class="DesktopHub.App.Main.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DesktopHub.App.Main.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:NullToVisibilityConverter x:Key="NullToVisibility" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Configurações" Style="{StaticResource TitleText}" />
      <TextBlock Text="Tudo é aplicado imediatamente e salvo neste computador." Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
      <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
              Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Foreground="{StaticResource WarningBrush}" />
      </Border>

      <!-- Geral -->
      <Border Style="{StaticResource Card}" Margin="0,24,0,0">
        <StackPanel>
          <TextBlock Text="Geral" Style="{StaticResource SubtitleText}" Margin="0,0,0,6" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Content="Iniciar com o Windows" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimized}" Content="Iniciar minimizado na bandeja" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}" Content="Fechar a janela mantém o app na bandeja (desligado: encerra o app)" />
          <TextBlock Text="Cor de destaque" Style="{StaticResource BodyText}" Margin="0,14,0,8" />
          <ItemsControl ItemsSource="{Binding Accents}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="30" Height="30" Margin="0,0,10,0" Cursor="Hand" ToolTip="{Binding Name}"
                        AutomationProperties.Name="{Binding Name}" Tag="{Binding Hex}" Click="Accent_Click"
                        FocusVisualStyle="{StaticResource FocusRing}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Grid>
                        <Ellipse x:Name="Ring" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Visibility="Hidden" />
                        <Ellipse Margin="4" Fill="{Binding Hex}" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Widget -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Widget flutuante" Style="{StaticResource SubtitleText}" Margin="0,0,0,6" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WidgetVisible}" Content="Mostrar widget  (Ctrl+Alt+H)" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlwaysOnTop}" Content="Sempre visível sobre outras janelas" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Locked}" Content="Bloquear posição (impede arrastar)" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideInFullscreen}" Content="Ocultar durante jogos e apps em tela cheia" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ExcludeFromCapture}" Content="Ocultar o widget em capturas de tela e gravações" />
          <TextBlock Text="O Windows recusou a exclusão de capturas neste sistema." Style="{StaticResource CaptionText}" Foreground="{StaticResource WarningBrush}"
                     Visibility="{Binding CaptureExclusionUnsupported, Converter={StaticResource BoolToVisibility}}" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AnimationsEnabled}" Content="Animações de transição" />
          <TextBlock Text="Os efeitos de animação estão desativados no Windows; o widget não anima independentemente desta opção."
                     Style="{StaticResource CaptionText}" Visibility="{Binding SystemAnimationsDisabled, Converter={StaticResource BoolToVisibility}}" />

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Opacidade" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Slider Grid.Column="1" Minimum="35" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                    SmallChange="5" LargeChange="10" Value="{Binding OpacityPercent}" VerticalAlignment="Center"
                    AutomationProperties.Name="Opacidade do widget" />
            <TextBlock Grid.Column="2" Text="{Binding OpacityPercent, StringFormat={}{0:0}%}" Style="{StaticResource BodyText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
          <Button Style="{StaticResource SecondaryButton}" Content="Recentralizar widget no monitor principal" HorizontalAlignment="Left"
                  Margin="0,14,0,0" Click="ResetPosition_Click" />
        </StackPanel>
      </Border>

      <!-- Atalhos -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Atalhos globais" Style="{StaticResource SubtitleText}" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Hotkeys}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Gesture}" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Atalhos personalizáveis chegam junto com a paleta de comandos (ver ROADMAP.md)." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <!-- Privacidade e dados -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Privacidade e dados" Style="{StaticResource SubtitleText}" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Sem telemetria. Nenhuma integração externa está ativa. Configurações, banco SQLite e logs ficam nesta pasta; tokens futuros serão cifrados com DPAPI (somente sua conta do Windows consegue lê-los)." />
          <TextBlock Text="{Binding DataFolder}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,10,0,0" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Abrir pasta de dados" Click="OpenData_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Abrir logs" Margin="10,0,0,0" Click="OpenLogs_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
