<UserControl x:Class="DesktopHub.App.Main.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DesktopHub.App.Main.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:NullToVisibilityConverter x:Key="NullToVisibility" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Configurações" Style="{StaticResource TitleText}" />
      <TextBlock Text="Tudo é aplicado imediatamente e salvo neste computador." Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
      <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
              Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Foreground="{DynamicResource WarningBrush}" />
      </Border>

      <!-- Geral -->
      <Border Style="{StaticResource Card}" Margin="0,24,0,0">
        <StackPanel>
          <TextBlock Text="Geral" Style="{StaticResource SubtitleText}" Margin="0,0,0,6" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Content="Iniciar com o Windows" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimized}" Content="Iniciar minimizado na bandeja" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}" Content="Fechar a janela mantém o app na bandeja (desligado: encerra o app)" />
          <TextBlock Text="Tamanho do texto da janela" Style="{StaticResource BodyText}" Margin="0,14,0,8" />
          <WrapPanel>
            <Button Style="{StaticResource Chip}" Content="Normal" Tag="1" Click="TextScale_Click" DataContext="{Binding TextScaleNormal}" />
            <Button Style="{StaticResource Chip}" Content="Grande (115%)" Tag="1.15" Click="TextScale_Click" DataContext="{Binding TextScaleLarge}" />
            <Button Style="{StaticResource Chip}" Content="Muito grande (130%)" Tag="1.3" Click="TextScale_Click" DataContext="{Binding TextScaleHuge}" />
          </WrapPanel>

          <TextBlock Text="Tema" Style="{StaticResource BodyText}" Margin="0,14,0,8" />
          <WrapPanel>
            <Button Style="{StaticResource Chip}" Content="Escuro" Tag="Dark" Click="Theme_Click" DataContext="{Binding ThemeDarkChip}" AutomationProperties.Name="Tema escuro" />
            <Button Style="{StaticResource Chip}" Content="Claro" Tag="Light" Click="Theme_Click" DataContext="{Binding ThemeLightChip}" AutomationProperties.Name="Tema claro" />
          </WrapPanel>
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" Text="Vale para a janela e o widget. Também dá para trocar pelo sol/lua na barra lateral." />

          <TextBlock Text="Cor de destaque" Style="{StaticResource BodyText}" Margin="0,14,0,8" />
          <ItemsControl ItemsSource="{Binding Accents}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="30" Height="30" Margin="0,0,10,0" Cursor="Hand" ToolTip="{Binding Name}"
                        AutomationProperties.Name="{Binding Name}" Tag="{Binding Hex}" Click="Accent_Click"
                        FocusVisualStyle="{StaticResource FocusRing}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Grid>
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Visibility="Hidden" />
                        <Ellipse Margin="4" Fill="{Binding Hex}" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Widget -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Widget flutuante" Style="{StaticResource SubtitleText}" Margin="0,0,0,6" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WidgetVisible}" Content="Mostrar widget  (Ctrl+Alt+H)" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlwaysOnTop}" Content="Sempre visível sobre outras janelas" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Locked}" Content="Bloquear posição (impede arrastar)" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideInFullscreen}" Content="Ocultar durante jogos e apps em tela cheia" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ExcludeFromCapture}" Content="Ocultar o widget em capturas de tela e gravações" />
          <TextBlock Text="O Windows recusou a exclusão de capturas neste sistema." Style="{StaticResource CaptionText}" Foreground="{DynamicResource WarningBrush}"
                     Visibility="{Binding CaptureExclusionUnsupported, Converter={StaticResource BoolToVisibility}}" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AnimationsEnabled}" Content="Animações de transição" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AnimatedPlaybackIndicator}" Content="Equalizador animado enquanto toca (modo compacto)" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,4"
                     Text="Animação contínua: medida em ~0,18% de CPU, contra ~0,01% com o indicador estático." />
          <TextBlock Text="Os efeitos de animação estão desativados no Windows; o widget não anima independentemente desta opção."
                     Style="{StaticResource CaptionText}" Visibility="{Binding SystemAnimationsDisabled, Converter={StaticResource BoolToVisibility}}" />

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Opacidade" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="35" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                    SmallChange="5" LargeChange="10" Value="{Binding OpacityPercent}" VerticalAlignment="Center"
                    AutomationProperties.Name="Opacidade do widget" />
            <TextBlock Grid.Column="2" Text="{Binding OpacityPercent, StringFormat={}{0:0}%}" Style="{StaticResource BodyText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
          <Button Style="{StaticResource SecondaryButton}" Content="Recentralizar widget no monitor principal" HorizontalAlignment="Left"
                  Margin="0,14,0,0" Click="ResetPosition_Click" />
        </StackPanel>
      </Border>

      <!-- Notificações -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Notificações" Style="{StaticResource SubtitleText}" Margin="0,0,0,6" />
          <TextBlock Text="{Binding WindowsNotificationStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TimerNotifications}" Content="Avisar quando temporizadores e fases do Pomodoro terminarem" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AgendaNotifications}" Content="Avisos de eventos do calendário e lembretes de tarefas" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SuppressInFullscreen}" Content="Não interromper jogos e apps em tela cheia (só avisos importantes passam)" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding QuietHoursEnabled}" Content="Horário de silêncio (só avisos importantes passam)" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,8" IsEnabled="{Binding QuietHoursEnabled}">
            <TextBlock Text="Das" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="70" Text="{Binding QuietStart}" AutomationProperties.Name="Início do horário de silêncio" />
            <TextBlock Text="às" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="8,0" />
            <TextBox Width="70" Text="{Binding QuietEnd}" AutomationProperties.Name="Fim do horário de silêncio" />
          </StackPanel>

          <TextBlock Text="{Binding PauseStatus}" Style="{StaticResource BodyText}" Margin="0,8,0,8" />
          <WrapPanel>
            <Button Style="{StaticResource SecondaryButton}" Content="Pausar 30 min" Margin="0,0,8,8" Tag="30" Click="Pause_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Pausar 1 h" Margin="0,0,8,8" Tag="60" Click="Pause_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Até eu reativar" Margin="0,0,8,8" Tag="0" Click="Pause_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Reativar" Margin="0,0,8,8" Click="Resume_Click" />
          </WrapPanel>

          <TextBlock Text="Últimas notificações" Style="{StaticResource BodyText}" Margin="0,10,0,4" />
          <ItemsControl ItemsSource="{Binding RecentNotifications}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding When}" Style="{StaticResource CaptionText}" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource BodyText}" />
                  <TextBlock Grid.Column="2" Text="{Binding Outcome}" Style="{StaticResource CaptionText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Finanças -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Finanças" Style="{StaticResource SubtitleText}" Margin="0,0,0,6" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FinanceDueReminders}" Content="Avisar vencimentos de contas, assinaturas e faturas" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
            <TextBlock Text="Avisar faturas de cartão" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding StatementReminderChoices}" SelectedItem="{Binding StatementReminderDays}" Width="70" Margin="10,0,8,0"
                      AutomationProperties.Name="Dias de antecedência do aviso de fatura" />
            <TextBlock Text="dias antes do vencimento" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8" TextWrapping="Wrap"
                     Text="Os avisos dizem só o que vence e quando, nunca o valor (aparecem na tela de bloqueio e no histórico do Windows). Contas e assinaturas usam o &quot;avisar N dias antes&quot; de cada uma." />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FinanceWidgetShowValues}" Content="Mostrar valores no painel Finanças do widget" />
          <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                     Text="Desligado (padrão): o widget mostra R$ •••• e o olho revela por 30 segundos. O modo privacidade de Finanças sempre oculta." />
        </StackPanel>
      </Border>

      <!-- Clima -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Clima" Style="{StaticResource SubtitleText}" Margin="0,0,0,4" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                     Text="Previsão do Open-Meteo (gratuito, sem conta). Você escolhe a cidade pelo nome; a localização automática não é usada. Só as coordenadas da cidade são enviadas." />
          <TextBlock Text="{Binding WeatherLocationText}" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CitySearchBox" AutomationProperties.Name="Buscar cidade" KeyDown="CitySearch_KeyDown" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Buscar cidade" Margin="8,0,0,0" Click="CitySearch_Click" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Remover local" Margin="8,0,0,0" Click="ClearLocation_Click" />
          </Grid>
          <TextBlock x:Name="CitySearchMessage" Style="{StaticResource CaptionText}" Margin="0,6,0,0" Visibility="Collapsed" />
          <StackPanel x:Name="CityResults" Margin="0,6,0,0" />
          <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WeatherInWidget}" Content="Mostrar a temperatura no cabeçalho do widget" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <!-- Agenda: categorias -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Categorias da agenda" Style="{StaticResource SubtitleText}" Margin="0,0,0,4" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                     Text="Cores de eventos e tarefas. Excluir uma categoria não apaga nada: os itens ficam sem categoria." />
          <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Width="28" Height="28" FontSize="12"
                          Tag="{Binding Id}" Click="DeleteCategory_Click" ToolTip="Excluir categoria"
                          AutomationProperties.Name="{Binding DeleteLabel}" />
                  <Ellipse Width="12" Height="12" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="2,0,10,0" />
                  <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewCategoryBox" MaxLength="40" AutomationProperties.Name="Nome da nova categoria" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Adicionar categoria" Margin="8,0,0,0" Click="AddCategory_Click" />
          </Grid>
          <TextBlock Text="{Binding CategoryError}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- Atalhos -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Atalhos globais" Style="{StaticResource SubtitleText}" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Hotkeys}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Gesture}" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Atalhos personalizáveis chegam junto com a paleta de comandos (ver ROADMAP.md)." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <!-- Privacidade e dados -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Privacidade e dados" Style="{StaticResource SubtitleText}" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource BodyText}" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="Sem telemetria. Nenhuma integração externa está ativa. Configurações, banco SQLite e logs ficam nesta pasta; tokens futuros serão cifrados com DPAPI (somente sua conta do Windows consegue lê-los)." />
          <TextBlock Text="{Binding DataFolder}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,10,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Abrir pasta de dados" Click="OpenData_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Abrir logs" Margin="10,0,0,0" Click="OpenLogs_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
