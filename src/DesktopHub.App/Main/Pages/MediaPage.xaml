<UserControl x:Class="DesktopHub.App.Main.Pages.MediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Mídia" Style="{StaticResource TitleText}" />
      <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                 Text="Controle local pelas sessões de mídia do Windows — sem login. Só aparecem apps que expõem esses controles; navegadores costumam expor uma sessão por navegador, enquanto há mídia tocando numa aba." />

      <!-- Tocando agora -->
      <Border Style="{StaticResource Card}" Margin="0,24,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="96" Height="96" CornerRadius="12" Background="{StaticResource SurfaceElevatedBrush}" VerticalAlignment="Top">
            <Grid>
              <TextBlock Style="{StaticResource IconText}" Text="&#xE8D6;" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}" />
              <Border x:Name="ArtBox" CornerRadius="12" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock x:Name="NowTitle" Style="{StaticResource SubtitleText}" FontSize="17" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="NowArtist" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            <TextBlock x:Name="NowDetail" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
            <StackPanel x:Name="NowButtons" Orientation="Horizontal" Margin="-6,10,0,0">
              <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;" AutomationProperties.Name="Faixa anterior" Click="Previous_Click" />
              <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="18" Margin="6,0"
                      Content="&#xE768;" AutomationProperties.Name="Tocar ou pausar" Click="PlayPause_Click" />
              <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" AutomationProperties.Name="Próxima faixa" Click="Next_Click" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sessões -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Sessões detectadas" Style="{StaticResource SubtitleText}" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,10"
                     Text="Escolha qual sessão o widget e a bandeja controlam. Comandos vão apenas para a sessão escolhida; se ela fechar, o comando falha em vez de ir para outra." />
          <ItemsControl x:Name="SessionList" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource Chip}" Margin="0,0,8,8" Tag="{Binding}" Click="Session_Click"
                        ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding AutomationName}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,6,0"
                               VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}" />
                    <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Preferências -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Preferências" Style="{StaticResource SubtitleText}" />
          <TextBlock Text="Fonte preferencial (usada quando você não fixou uma sessão)" Style="{StaticResource BodyText}" Margin="0,12,0,8" />
          <ItemsControl x:Name="PreferredList" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource Chip}" Margin="0,0,8,8" Tag="{Binding}" Click="Preferred_Click"
                        ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding AutomationName}">
                  <TextBlock Text="{Binding Label}" FontSize="12.5" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox x:Name="ShowArtwork" Style="{StaticResource ToggleSwitch}" Content="Mostrar capas de álbum"
                    Checked="ShowArtwork_Changed" Unchecked="ShowArtwork_Changed" />
        </StackPanel>
      </Border>

      <!-- Spotify -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Spotify Web API (opcional)" Style="{StaticResource SubtitleText}" />
          <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"
                     Text="Integração complementar, separada do controle local: biblioteca, filas e dispositivos Spotify Connect. Usa OAuth no navegador (nenhuma senha aqui). Comandos de reprodução pela API exigem conta Premium. O controle local acima funciona sem ela." />
          <Border Style="{StaticResource Badge}" Margin="0,10,0,0">
            <TextBlock Text="Não configurado · chega na Fase 6" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
