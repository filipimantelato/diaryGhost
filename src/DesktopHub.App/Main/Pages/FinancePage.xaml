<UserControl x:Class="DesktopHub.App.Main.Pages.FinancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,28,24,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Cabeçalho: título, mês, privacidade e novo lançamento -->
    <WrapPanel x:Name="HeaderPanel">
      <StackPanel x:Name="TitlePanel" Margin="0,0,24,10">
        <TextBlock Text="Finanças" Style="{StaticResource TitleText}" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                   Text="Tudo fica neste computador. Nenhum dado financeiro sai do app." />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
        <Button x:Name="PrevMonth" Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Mês anterior" AutomationProperties.Name="Mês anterior" Click="PrevMonth_Click" />
        <TextBlock x:Name="MonthText" Style="{StaticResource SubtitleText}" MinWidth="150" TextAlignment="Center" VerticalAlignment="Center" />
        <Button x:Name="NextMonth" Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Próximo mês" AutomationProperties.Name="Próximo mês" Click="NextMonth_Click" />
        <Button x:Name="TodayButton" Style="{StaticResource Chip}" Content="Este mês" Margin="6,0,12,0" Click="Today_Click" />
        <ToggleButton x:Name="PrivacyButton" Style="{StaticResource IconToggleButton}" Content="&#xE890;" ToolTip="Modo privacidade: ocultar valores (Ctrl+Shift+H)"
                      AutomationProperties.Name="Modo privacidade: ocultar valores" Checked="Privacy_Changed" Unchecked="Privacy_Changed" />
        <Button x:Name="NewButton" Style="{StaticResource AccentButton}" Content="+ Lançamento" Margin="8,0,0,0" Click="New_Click"
                AutomationProperties.Name="Novo lançamento" />
      </StackPanel>
    </WrapPanel>

    <!-- Resumo do mês: 4 colunas, ou 2×2 em larguras menores (ex.: com o editor aberto) -->
    <UniformGrid x:Name="SummaryGrid" Grid.Row="1" Columns="4" Margin="0,8,-10,0" SizeChanged="Summary_SizeChanged" />

    <!-- Seções -->
    <WrapPanel Grid.Row="2" Margin="0,6,0,10" AutomationProperties.Name="Seções de finanças">
      <Button x:Name="TabOverview" Style="{StaticResource Chip}" Content="Visão geral" Tag="Overview" Click="Tab_Click" />
      <Button x:Name="TabTransactions" Style="{StaticResource Chip}" Content="Lançamentos" Tag="Transactions" Click="Tab_Click" />
      <Button x:Name="TabAccounts" Style="{StaticResource Chip}" Content="Contas" Tag="Accounts" Click="Tab_Click" />
      <Button x:Name="TabCards" Style="{StaticResource Chip}" Content="Cartões" Tag="Cards" Click="Tab_Click" />
      <Button x:Name="TabPlanning" Style="{StaticResource Chip}" Content="Planejamento" Tag="Planning" Click="Tab_Click" />
      <Button x:Name="TabProjections" Style="{StaticResource Chip}" Content="Projeções" Tag="Projections" Click="Tab_Click" />
      <Button x:Name="TabCategories" Style="{StaticResource Chip}" Content="Categorias" Tag="Categories" Click="Tab_Click" />
    </WrapPanel>

    <!-- Filtros (só em Lançamentos) -->
    <WrapPanel x:Name="FilterBar" Grid.Row="3" Margin="0,0,0,10">
      <Grid Width="220" Margin="0,0,8,6">
        <TextBox x:Name="SearchBox" AutomationProperties.Name="Buscar em descrição, observações, etiquetas e categoria" TextChanged="Filter_Changed" />
        <TextBlock x:Name="SearchHint" Text="Buscar…" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="13" />
      </Grid>
      <ComboBox x:Name="AccountFilter" Width="160" Margin="0,0,8,6" AutomationProperties.Name="Filtrar por conta" SelectionChanged="Filter_Changed" />
      <ComboBox x:Name="CategoryFilter" Width="170" Margin="0,0,8,6" AutomationProperties.Name="Filtrar por categoria" SelectionChanged="Filter_Changed" />
      <ComboBox x:Name="KindFilter" Width="150" Margin="0,0,8,6" AutomationProperties.Name="Filtrar por tipo" SelectionChanged="Filter_Changed" />
      <ComboBox x:Name="StatusFilter" Width="160" Margin="0,0,8,6" AutomationProperties.Name="Filtrar por situação" SelectionChanged="Filter_Changed" />
      <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
        <TextBlock Text="Valor de" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="2,0,6,0" />
        <TextBox x:Name="MinBox" Width="78" ToolTip="Valor mínimo (vazio = sem mínimo)" AutomationProperties.Name="Valor mínimo" TextChanged="Filter_Changed" />
        <TextBlock Text="até" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,0,6,0" />
        <TextBox x:Name="MaxBox" Width="78" ToolTip="Valor máximo (vazio = sem máximo)" AutomationProperties.Name="Valor máximo" TextChanged="Filter_Changed" />
      </StackPanel>
      <Button x:Name="AllTimeChip" Style="{StaticResource Chip}" Content="Todo o período" Margin="0,0,6,6" Click="AllTime_Click" />
      <Button x:Name="ClearFilters" Style="{StaticResource Chip}" Content="Limpar filtros" Margin="0,0,6,6" Click="ClearFilters_Click" />
    </WrapPanel>

    <Border x:Name="ListCard" Grid.Row="4" Style="{StaticResource Card}" Padding="0">
      <ScrollViewer x:Name="ListScroll" SizeChanged="ListScroll_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ListPanel" Margin="16,8,16,16" />
      </ScrollViewer>
    </Border>

    <!-- Rodapé: totais do filtro e "desfazer" -->
    <DockPanel Grid.Row="5" Margin="2,10,0,0">
      <Border x:Name="UndoBar" DockPanel.Dock="Right" Style="{StaticResource Badge}" Visibility="Collapsed" Padding="10,4">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="UndoText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
          <Button Style="{StaticResource Chip}" Content="Desfazer" Margin="10,0,0,0" Click="Undo_Click" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="FooterText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
    </DockPanel>

    <ContentControl x:Name="EditorHost" Grid.Column="1" Grid.RowSpan="6" Width="340" Margin="16,0,0,0" Focusable="False" Visibility="Collapsed" />
  </Grid>
</UserControl>
