<UserControl x:Class="DesktopHub.App.Main.Pages.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Item de evento: botão (focável e lido pelo Narrador), com aparência de etiqueta colorida -->
    <Style x:Key="EventChip" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="3,0,0,0" CornerRadius="4" Padding="6,2">
              <ContentPresenter VerticalAlignment="Top" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DayCell" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderTokenBrush}" BorderThickness="0,0,1,1" Padding="6,4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="32,28,24,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Calendário" Style="{StaticResource TitleText}" />
      <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                 Text="Calendário local, guardado só neste computador. Avisos chegam como notificações do Windows enquanto o Diary Ghost estiver aberto (mesmo minimizado na bandeja)." />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,18,0,12" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="ViewDay" Style="{StaticResource Chip}" Content="Dia" Tag="Day" Click="View_Click" />
        <Button x:Name="ViewWeek" Style="{StaticResource Chip}" Content="Semana" Tag="Week" Click="View_Click" />
        <Button x:Name="ViewMonth" Style="{StaticResource Chip}" Content="Mês" Tag="Month" Click="View_Click" />
        <Button x:Name="ViewList" Style="{StaticResource Chip}" Content="Lista" Tag="List" Click="View_Click" Margin="0,0,14,0" />
        <Button x:Name="OverlayToggle" Style="{StaticResource Chip}" Content="Finanças" Margin="0,0,14,0" Click="Overlay_Click" Visibility="Collapsed"
                ToolTip="Mostrar vencimentos de contas, assinaturas e faturas" />
        <Button Style="{StaticResource AccentButton}" Content="Novo evento" Click="NewEvent_Click" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SecondaryButton}" Content="Hoje" Padding="12,5" Click="Today_Click" />
        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Margin="8,0,0,0" ToolTip="Anterior" AutomationProperties.Name="Período anterior" Click="Previous_Click" />
        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Próximo" AutomationProperties.Name="Próximo período" Click="Next_Click" />
        <TextBlock x:Name="PeriodText" Style="{StaticResource SubtitleText}" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
      <ContentControl x:Name="ViewHost" Focusable="False" />
    </Border>

    <!-- Editor em gaveta sobre o calendário: a barra de navegação não perde espaço -->
    <ContentControl x:Name="EditorHost" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Width="360" HorizontalAlignment="Right"
                    Focusable="False" Visibility="Collapsed">
      <ContentControl.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
      </ContentControl.Effect>
    </ContentControl>
  </Grid>
</UserControl>
