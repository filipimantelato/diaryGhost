<UserControl x:Class="DesktopHub.App.Main.Pages.ProductivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="BigTime" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="40" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,32,40,40" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="Produtividade" Style="{StaticResource TitleText}" />
      <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                 Text="Tudo continua contando com a janela fechada, o widget oculto ou o PC suspenso: os tempos são calculados a partir do horário em que começaram, não por tiques." />

      <Grid Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pomodoro -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Pomodoro" Style="{StaticResource SubtitleText}" />
            <TextBlock x:Name="PomodoroStatus" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
            <TextBlock x:Name="PomodoroTime" Style="{StaticResource BigTime}" AutomationProperties.Name="Tempo do Pomodoro" />
            <TextBlock x:Name="PomodoroDots" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Orientation="Horizontal" Margin="-6,8,0,0">
              <Button x:Name="PomodoroPrimary" Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="16" Click="PomodoroPrimary_Click" />
              <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Pular para a próxima fase" AutomationProperties.Name="Pular fase" Click="PomodoroSkip_Click" />
              <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reiniciar o ciclo" AutomationProperties.Name="Reiniciar Pomodoro" Click="PomodoroReset_Click" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderTokenBrush}" Margin="0,14" />
            <Grid x:Name="PomodoroConfigGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Text="Foco" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource StepButton}" Content="&#xE738;" Tag="focus:-5" Click="Step_Click" AutomationProperties.Name="Diminuir foco" />
                <TextBlock x:Name="FocusMinutesText" Width="56" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Style="{StaticResource StepButton}" Content="&#xE710;" Tag="focus:5" Click="Step_Click" AutomationProperties.Name="Aumentar foco" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Pausa curta" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource StepButton}" Content="&#xE738;" Tag="short:-1" Click="Step_Click" AutomationProperties.Name="Diminuir pausa curta" />
                <TextBlock x:Name="ShortMinutesText" Width="56" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Style="{StaticResource StepButton}" Content="&#xE710;" Tag="short:1" Click="Step_Click" AutomationProperties.Name="Aumentar pausa curta" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="Pausa longa" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource StepButton}" Content="&#xE738;" Tag="long:-5" Click="Step_Click" AutomationProperties.Name="Diminuir pausa longa" />
                <TextBlock x:Name="LongMinutesText" Width="56" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Style="{StaticResource StepButton}" Content="&#xE710;" Tag="long:5" Click="Step_Click" AutomationProperties.Name="Aumentar pausa longa" />
              </StackPanel>
              <TextBlock Grid.Row="3" Text="Focos até a pausa longa" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource StepButton}" Content="&#xE738;" Tag="cycles:-1" Click="Step_Click" AutomationProperties.Name="Menos ciclos" />
                <TextBlock x:Name="CyclesText" Width="56" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Style="{StaticResource StepButton}" Content="&#xE710;" Tag="cycles:1" Click="Step_Click" AutomationProperties.Name="Mais ciclos" />
              </StackPanel>
            </Grid>
            <CheckBox x:Name="AutoStartNext" Style="{StaticResource ToggleSwitch}" Content="Iniciar a próxima fase automaticamente"
                      Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
          <!-- Temporizador -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Temporizador" Style="{StaticResource SubtitleText}" />
              <StackPanel x:Name="TimerActive" Margin="0,10,0,0">
                <TextBlock x:Name="TimerStatus" Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="TimerTime" Style="{StaticResource BigTime}" AutomationProperties.Name="Tempo do temporizador" />
                <StackPanel Orientation="Horizontal" Margin="-6,4,0,0">
                  <Button x:Name="TimerPrimary" Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="16" Click="TimerPrimary_Click" />
                  <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reiniciar" AutomationProperties.Name="Reiniciar temporizador" Click="TimerReset_Click" />
                  <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Escolher outra duração" AutomationProperties.Name="Escolher outra duração" Click="TimerClear_Click" />
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="TimerSetup" Margin="0,10,0,0">
                <WrapPanel>
                  <Button Style="{StaticResource Chip}" Content="5 min" Tag="5" Margin="0,0,6,6" Click="TimerPreset_Click" />
                  <Button Style="{StaticResource Chip}" Content="10 min" Tag="10" Margin="0,0,6,6" Click="TimerPreset_Click" />
                  <Button Style="{StaticResource Chip}" Content="15 min" Tag="15" Margin="0,0,6,6" Click="TimerPreset_Click" />
                  <Button Style="{StaticResource Chip}" Content="25 min" Tag="25" Margin="0,0,6,6" Click="TimerPreset_Click" />
                  <Button Style="{StaticResource Chip}" Content="30 min" Tag="30" Margin="0,0,6,6" Click="TimerPreset_Click" />
                  <Button Style="{StaticResource Chip}" Content="60 min" Tag="60" Margin="0,0,6,6" Click="TimerPreset_Click" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBox x:Name="CustomMinutes" Width="70" AutomationProperties.Name="Minutos personalizados" KeyDown="CustomMinutes_KeyDown" />
                  <TextBlock Text="min" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="8,0,12,0" />
                  <Button Style="{StaticResource SecondaryButton}" Content="Iniciar" Click="CustomStart_Click" />
                </StackPanel>
                <TextBlock x:Name="CustomError" Style="{StaticResource CaptionText}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0" Visibility="Collapsed"
                           Text="Use um número inteiro de minutos entre 1 e 1440." />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Cronômetro -->
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Cronômetro" Style="{StaticResource SubtitleText}" />
              <TextBlock x:Name="StopwatchStatus" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
              <TextBlock x:Name="StopwatchTime" Style="{StaticResource BigTime}" AutomationProperties.Name="Tempo do cronômetro" />
              <StackPanel Orientation="Horizontal" Margin="-6,4,0,0">
                <Button x:Name="StopwatchPrimary" Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="16" Click="StopwatchPrimary_Click" />
                <Button x:Name="StopwatchLapButton" Style="{StaticResource IconButton}" Content="&#xE7C1;" ToolTip="Registrar volta" AutomationProperties.Name="Registrar volta" Click="StopwatchLap_Click" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Zerar" AutomationProperties.Name="Zerar cronômetro" Click="StopwatchReset_Click" />
              </StackPanel>
              <ItemsControl x:Name="LapList" Margin="0,8,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource BodyText}" FontFamily="Cascadia Mono, Consolas" />
                      <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Estatísticas -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Estatísticas" Style="{StaticResource SubtitleText}" />
          <UniformGrid Columns="4" Margin="0,12,0,0">
            <StackPanel><TextBlock x:Name="StatFocusToday" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="de foco hoje" Style="{StaticResource CaptionText}" /></StackPanel>
            <StackPanel><TextBlock x:Name="StatPomodorosToday" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Pomodoros concluídos hoje" Style="{StaticResource CaptionText}" /></StackPanel>
            <StackPanel><TextBlock x:Name="StatFocusWeek" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="de foco em 7 dias" Style="{StaticResource CaptionText}" /></StackPanel>
            <StackPanel><TextBlock x:Name="StatSessionsWeek" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="sessões em 7 dias" Style="{StaticResource CaptionText}" /></StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- Histórico -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Histórico recente" Style="{StaticResource SubtitleText}" />
          <TextBlock x:Name="HistoryEmpty" Text="Nenhuma sessão registrada ainda." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
          <ItemsControl x:Name="HistoryList" Margin="0,8,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding When}" Style="{StaticResource CaptionText}" />
                  <TextBlock Grid.Column="1" Text="{Binding What}" Style="{StaticResource BodyText}" />
                  <TextBlock Grid.Column="2" Text="{Binding Result}" Style="{StaticResource CaptionText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
