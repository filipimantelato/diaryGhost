<UserControl x:Class="DesktopHub.App.Main.Pages.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,28,24,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Tarefas" Style="{StaticResource TitleText}" />
      <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="QuickAddBox" MaxLength="200" AutomationProperties.Name="Nova tarefa: digite o título e pressione Enter" KeyDown="QuickAdd_KeyDown" />
      <TextBlock x:Name="QuickAddHint" Text="Adicionar tarefa para hoje… (Enter)" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                 Foreground="{StaticResource TextTertiaryBrush}" FontSize="13" />
      <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Com detalhes…" Margin="8,0,0,0" Click="NewDetailed_Click" />
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,12,0,10">
      <ComboBox x:Name="CategoryFilter" DockPanel.Dock="Right" Width="170" AutomationProperties.Name="Filtrar por categoria" SelectionChanged="Filter_Changed" />
      <WrapPanel VerticalAlignment="Center">
        <Button x:Name="FilterOpen" Style="{StaticResource Chip}" Content="Pendentes" Tag="Open" Click="Filter_Click" />
        <Button x:Name="FilterToday" Style="{StaticResource Chip}" Content="Hoje" Tag="Today" Click="Filter_Click" />
        <Button x:Name="FilterUpcoming" Style="{StaticResource Chip}" Content="Próximos 7 dias" Tag="Upcoming" Click="Filter_Click" />
        <Button x:Name="FilterNoDate" Style="{StaticResource Chip}" Content="Sem prazo" Tag="NoDate" Click="Filter_Click" />
        <Button x:Name="FilterDone" Style="{StaticResource Chip}" Content="Concluídas" Tag="Done" Click="Filter_Click" />
      </WrapPanel>
    </DockPanel>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ListPanel" Margin="16,8,16,16" />
      </ScrollViewer>
    </Border>

    <ContentControl x:Name="EditorHost" Grid.Column="1" Grid.RowSpan="4" Width="360" Margin="16,0,0,0" Focusable="False" Visibility="Collapsed" />
  </Grid>
</UserControl>
