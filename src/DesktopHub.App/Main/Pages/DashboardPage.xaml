<UserControl x:Class="DesktopHub.App.Main.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,32,24,32">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="ResetButton" Style="{StaticResource SecondaryButton}" Content="Restaurar padrão" Margin="0,0,8,0" Visibility="Collapsed" Click="Reset_Click" />
          <Button x:Name="CustomizeButton" Style="{StaticResource SecondaryButton}" Content="Personalizar" Click="Customize_Click" />
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="GreetingText" Style="{StaticResource TitleText}" />
          <TextBlock x:Name="DateText" Margin="0,4,0,0" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
      </DockPanel>

      <TextBlock x:Name="CustomizeHint" Style="{StaticResource CaptionText}" Margin="0,16,0,0" Visibility="Collapsed"
                 Text="Use as setas para reordenar, o botão de largura para alternar entre normal e largo, e o olho para ocultar. Cartões ocultos aparecem abaixo para trazer de volta." />
      <WrapPanel x:Name="CardsPanel" Margin="0,24,0,0" />
      <WrapPanel x:Name="HiddenPanel" Margin="0,4,0,0" Visibility="Collapsed" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
