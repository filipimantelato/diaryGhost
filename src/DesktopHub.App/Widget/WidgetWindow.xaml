<Window x:Class="DesktopHub.App.Widget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Hub — Widget"
        Width="440" Height="176"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Left="0" Top="0"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- A janela é uma "tela" transparente de tamanho fixo. Pixels com alfa 0 não capturam cliques,
       então só a ilha interage com o mouse. A ilha anima dentro da tela; o HWND nunca é redimensionado. -->
  <Grid>
    <Border x:Name="Island"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Width="252" Height="44" CornerRadius="22"
            Background="{StaticResource IslandBrush}"
            BorderBrush="{StaticResource BorderTokenBrush}" BorderThickness="1"
            AutomationProperties.Name="Widget do Desktop Hub"
            MouseLeftButtonDown="Island_MouseLeftButtonDown"
            MouseMove="Island_MouseMove"
            MouseLeftButtonUp="Island_MouseLeftButtonUp"
            LostMouseCapture="Island_LostMouseCapture">
      <Grid>
        <!-- Estado compacto -->
        <Grid x:Name="CompactView" Margin="16,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
          <TextBlock x:Name="CompactGlyph" Grid.Column="1" Style="{StaticResource IconText}" FontSize="14"
                     Margin="10,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="CompactClock" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="CompactStatus" FontSize="12" Margin="8,0,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE70D;"
                  ToolTip="Expandir" AutomationProperties.Name="Expandir widget" Click="Expand_Click" />
        </Grid>

        <!-- Estado expandido -->
        <Grid x:Name="ExpandedView" Margin="12,8,8,12" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleButton}" Content="&#xE718;"
                            ToolTip="Sempre visível sobre outras janelas" AutomationProperties.Name="Sempre visível"
                            Checked="Pin_Changed" Unchecked="Pin_Changed" />
              <ToggleButton x:Name="LockButton" Style="{StaticResource IconToggleButton}" Content="&#xE72E;"
                            ToolTip="Bloquear posição" AutomationProperties.Name="Bloquear posição"
                            Checked="Lock_Changed" Unchecked="Lock_Changed" />
              <Button Style="{StaticResource IconButton}" Content="&#xE70E;"
                      ToolTip="Recolher" AutomationProperties.Name="Recolher widget" Click="Collapse_Click" />
              <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                      ToolTip="Ocultar widget (o app continua na bandeja)" AutomationProperties.Name="Ocultar widget" Click="Hide_Click" />
            </StackPanel>
            <StackPanel x:Name="PanelTabs" Orientation="Horizontal">
              <RadioButton x:Name="TabMedia" GroupName="WidgetPanel" Style="{StaticResource IconToggleButton}" Content="&#xE8D6;" ToolTip="Mídia" AutomationProperties.Name="Mídia" Checked="Tab_Checked" />
              <RadioButton x:Name="TabFocus" GroupName="WidgetPanel" Style="{StaticResource IconToggleButton}" Content="&#xE916;" ToolTip="Foco" AutomationProperties.Name="Foco" Checked="Tab_Checked" />
              <RadioButton x:Name="TabAgenda" GroupName="WidgetPanel" Style="{StaticResource IconToggleButton}" Content="&#xE787;" ToolTip="Agenda" AutomationProperties.Name="Agenda" Checked="Tab_Checked" />
              <RadioButton x:Name="TabInfo" GroupName="WidgetPanel" Style="{StaticResource IconToggleButton}" Content="&#xE946;" ToolTip="Hoje" AutomationProperties.Name="Hoje" Checked="Tab_Checked" />
              <RadioButton x:Name="TabActivity" GroupName="WidgetPanel" Style="{StaticResource IconToggleButton}" Content="&#xE943;" ToolTip="Atividade" AutomationProperties.Name="Atividade de integrações" Checked="Tab_Checked" />
            </StackPanel>
          </DockPanel>

          <StackPanel x:Name="PanelContent" Grid.Row="1" Margin="6,10,6,0">
            <TextBlock x:Name="PanelTitle" Style="{StaticResource SubtitleText}" />
            <TextBlock x:Name="PanelBody" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
            <Border Style="{StaticResource Badge}" Margin="0,10,0,0">
              <TextBlock x:Name="PanelBadge" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
