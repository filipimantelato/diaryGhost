<UserControl x:Class="DesktopHub.App.Agenda.EventEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </UserControl.Resources>
  <Border Style="{StaticResource Card}" Padding="18,16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionText}" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" Margin="0,0,0,8" />
        <DockPanel>
          <Button x:Name="DeleteButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Excluir"
                  AutomationProperties.Name="Excluir evento" Click="Delete_Click" />
          <WrapPanel>
            <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="Salvar" Margin="0,0,8,6" Click="Save_Click" IsDefault="True" />
            <Button x:Name="SaveOneButton" Style="{StaticResource SecondaryButton}" Content="Salvar só esta" Margin="0,0,8,6" Click="SaveOne_Click"
                    ToolTip="Altera só esta ocorrência; o resto da série continua igual" Visibility="Collapsed" />
            <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" Margin="0,0,8,6" Click="Cancel_Click" IsCancel="True" />
          </WrapPanel>
        </DockPanel>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
          <TextBlock x:Name="HeaderText" Style="{StaticResource SubtitleText}" />

          <TextBlock Text="Título" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="TitleBox" MaxLength="200" AutomationProperties.Name="Título do evento" />

          <CheckBox x:Name="AllDayBox" Style="{StaticResource ToggleSwitch}" Content="Dia inteiro" Margin="0,12,0,0"
                    Checked="AllDay_Changed" Unchecked="AllDay_Changed" />

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Data" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="DateBox" AutomationProperties.Name="Data (dd/mm/aaaa)" ToolTip="dd/mm/aaaa, &quot;hoje&quot; ou &quot;amanhã&quot;" LostFocus="Date_LostFocus" />
            </StackPanel>
            <StackPanel x:Name="StartPanel" Grid.Column="2">
              <TextBlock Text="Início" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="StartBox" AutomationProperties.Name="Hora de início" ToolTip="Ex.: 14:30, 14h, 9" />
            </StackPanel>
            <StackPanel x:Name="EndPanel" Grid.Column="4">
              <TextBlock Text="Fim" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="EndBox" AutomationProperties.Name="Hora de término" ToolTip="Antes do início = termina no dia seguinte" />
            </StackPanel>
            <StackPanel x:Name="DaysPanel" Grid.Column="2" Grid.ColumnSpan="3" Visibility="Collapsed">
              <TextBlock Text="Dias" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="DaysBox" AutomationProperties.Name="Duração em dias" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Repetição" Style="{StaticResource FieldLabel}" />
          <ComboBox x:Name="RepeatBox" AutomationProperties.Name="Repetição" SelectionChanged="Repeat_Changed" />
          <TextBox x:Name="CustomRuleBox" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.Name="Regra RRULE"
                   ToolTip="Ex.: FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1 (último dia útil do mês)" />
          <Grid x:Name="EndRow" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="EndModeBox" AutomationProperties.Name="Fim da repetição" SelectionChanged="EndMode_Changed" />
            <TextBox x:Name="EndValueBox" Grid.Column="2" AutomationProperties.Name="Vezes ou data final" />
          </Grid>

          <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}" />
          <ComboBox x:Name="CategoryBox" AutomationProperties.Name="Categoria" />

          <TextBlock Text="Avisos" Style="{StaticResource FieldLabel}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Reminder1Box" AutomationProperties.Name="Primeiro aviso" />
            <ComboBox x:Name="Reminder2Box" Grid.Column="2" AutomationProperties.Name="Segundo aviso" />
          </Grid>
          <TextBlock x:Name="AllDayReminderHint" Style="{StaticResource CaptionText}" Margin="0,4,0,0" Visibility="Collapsed"
                     Text="Em eventos de dia inteiro, o aviso conta a partir das 09:00 do dia." />

          <TextBlock Text="Local" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="LocationBox" MaxLength="200" AutomationProperties.Name="Local" />

          <TextBlock Text="Notas" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="NotesBox" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top"
                   AutomationProperties.Name="Notas" />

          <TextBlock x:Name="SeriesHint" Style="{StaticResource CaptionText}" Margin="0,10,0,0" Visibility="Collapsed"
                     Text="Este evento se repete. &quot;Salvar&quot; altera a série inteira (mudanças de horário valem para todas as ocorrências)." />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
