<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Tokens do design system. A cor de destaque é substituída em tempo de execução (ThemeManager);
       por isso é sempre referenciada com DynamicResource. -->
  <Color x:Key="BgColor">#141414</Color>
  <Color x:Key="SurfaceColor">#1C1C1C</Color>
  <Color x:Key="SurfaceElevatedColor">#262626</Color>
  <Color x:Key="BorderColor">#2E2E2E</Color>
  <Color x:Key="BorderStrongColor">#3D3D3D</Color>
  <Color x:Key="TextPrimaryColor">#EDEDED</Color>
  <Color x:Key="TextSecondaryColor">#A1A1A1</Color>
  <Color x:Key="TextTertiaryColor">#8F8F8F</Color>
  <Color x:Key="SuccessColor">#34D399</Color>
  <Color x:Key="WarningColor">#F0985A</Color>
  <Color x:Key="DangerColor">#F87171</Color>
  <!-- Fundo da ilha: quase opaco; a opacidade configurável é aplicada na janela inteira. -->
  <Color x:Key="IslandColor">#F50F0F0F</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
  <SolidColorBrush x:Key="BorderTokenBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="IslandBrush" Color="{StaticResource IslandColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="#C9A94E" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#C9A94E" Opacity="0.16" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <!-- Segoe Fluent Icons acompanha o Windows 11; MDL2 é o fallback do Windows 10. -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
